{
  "name": "pi-agent-computer-use",
  "version": "0.0.0",
  "private": true,
  "description": "Window-first computer use for Pi with bundled platform-native CUA runtimes.",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./.pi/skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bench:windows": "node --experimental-transform-types --disable-warning=ExperimentalWarning bench/run-windows-tasks.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "pi-test run -- vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:ide": "node scripts/link-ide-source.mjs",
    "probe:driver": "node scripts/probe-driver.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "pi-agent-ide": "^0.8.3",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "24.0.4",
    "pi-coding-agent-eval": "0.1.1",
    "pi-coding-agent-test": "0.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "files": [
    "src/",
    "scripts/",
    ".pi/skills/",
    "docs/",
    "README.md"
  ],
  "optionalDependencies": {
    "@alexshp/cua-runtime-darwin-arm64": "0.34.0-dev.819fa500b8bc",
    "@alexshp/cua-runtime-darwin-x64": "0.34.0-dev.819fa500b8bc",
    "@alexshp/cua-runtime-linux-x64": "0.34.0-dev.819fa500b8bc",
    "@alexshp/cua-runtime-win32-x64": "0.34.0-dev.819fa500b8bc"
  }
}
