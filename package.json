{
  "name": "pi-agent-computer-use",
  "version": "0.1.0",
  "description": "Computer use for the Pi coding agent: Windows apps, browsers and desktops through native UI trees, screenshots and real input, as a Pi Agent IDE plugin or standalone tools",
  "keywords": [
    "accessibility",
    "agent-tools",
    "ai-agent",
    "automation",
    "browser-automation",
    "cdp",
    "chrome",
    "codemode",
    "computer-use",
    "cua",
    "desktop-automation",
    "edge",
    "electron",
    "gui-automation",
    "ocr",
    "pi",
    "pi-agent",
    "pi-agent-ide",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "playwright",
    "rpa",
    "sandbox",
    "screenshot",
    "ui-automation",
    "uia",
    "vision",
    "webview2",
    "windows",
    "windows-automation",
    "windows-sandbox",
    "wsl"
  ],
  "license": "MIT",
  "author": "Alex Shpunt",
  "homepage": "https://github.com/alexshpunt/pi-agent-computer-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexshpunt/pi-agent-computer-use.git"
  },
  "bugs": {
    "url": "https://github.com/alexshpunt/pi-agent-computer-use/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./.pi/skills/computer-use"
    ],
    "image": "https://raw.githubusercontent.com/alexshpunt/pi-agent-computer-use/develop/assets/banner.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepack": "node scripts/fetch-runtime.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "pi-test run -- vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:ide": "node scripts/link-ide-source.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "pi-agent-ide": "^0.9.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "24.0.4",
    "pi-coding-agent-eval": "0.1.1",
    "pi-coding-agent-test": "0.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "files": [
    "src/",
    "scripts/",
    "native/",
    "native-runtime/win32-x64/runtime/",
    "native-runtime/win32-x64/runtime.source",
    "vscode-browser-bridge/",
    ".pi/skills/computer-use/",
    "docs/",
    "assets/banner.png",
    "LICENSE",
    "README.md"
  ]
}
